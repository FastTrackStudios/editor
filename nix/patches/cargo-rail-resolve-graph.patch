+    // Add dependency edges. Prefer cargo's resolve graph: it is keyed by
+    // package ID (immune to name collisions between workspace members,
+    // multi-version externals, and third-party manifests' dev-deps that
+    // are never built — e.g. iroh dev-depends on a crates.io crate named
+    // `patchbay`, which must not alias a workspace crate of that name).
+    if let Some(resolve) = &metadata.resolve {
+      for node in &resolve.nodes {
+        let Some(from_idx) = id_to_node.get(&node.id) else { continue };
+        for dep in &node.deps {
+          if let Some(to_idx) = id_to_node.get(&dep.pkg) {
+            if dep.dep_kinds.is_empty() {
+              graph.add_edge(*from_idx, *to_idx, cargo_metadata::DependencyKind::Normal);
+            }
+            for k in &dep.dep_kinds {
+              graph.add_edge(*from_idx, *to_idx, k.kind);
+            }
+          }
+        }
+      }
+    } else {
+      // Fallback (metadata ran with --no-deps): manifest names.
+      for package in &metadata.packages {
+        let from_idx = id_to_node[&package.id];
+
+        for dep in &package.dependencies {
+          // Find the resolved dependency
+          if let Some(to_idx) = name_to_node.get(dep.name.as_str()) {
+            graph.add_edge(from_idx, *to_idx, dep.kind);
+          }
         }
