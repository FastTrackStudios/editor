# Build artifacts
/target
**/target
/dist
**/dist
result
result-*
.direnv/
.cache
*.profraw
.DS_Store

# Generated Tailwind sheets. The ONE input is apps/tailwind.css; each
# app's build.rs compiles it into that app's assets/ (asset!() cannot
# reach outside its crate, so the output is per-app). They must exist
# before cargo runs, because asset!() resolves them at compile time —
# dx builds them during `dx serve`/`dx build`, and CI generates them
# explicitly (see .github/workflows/checks.yml). These were committed
# until 2026-07-27 — ~19,500 lines of build output that had to be
# regenerated by hand and was reliably stale. Don't re-add them.
apps/web/assets/tailwind.css
apps/desktop/assets/tailwind.css
apps/mobile/assets/tailwind.css

# Node / vendored builds
node_modules/
/node_modules

# Databases / SQLite runtime files
*.db
*.db-journal
*.db-shm
*.db-wal
.dolt/

# Local-only env overrides (`.envrc` itself is tracked — see architect's
# pattern; `.envrc.local` is the per-machine escape hatch)
.envrc.local
.env

# Local-only tool state — wt worktree config, tracey config — these are
# per-machine, never shared.
.config/tracey/
.config/wt.toml

# IDE / agent scratch
.claude/worktrees/
.claude/
examples/vault/.obsidian/

# deploy: staged image artifacts (see deploy/docker/*.Dockerfile)
deploy/docker/web-public/

# Playwright (apps/tests, features/editor/tests)
**/playwright-report/
**/test-results/
**/.playwright/

# Editor playground
**/playground.log*

# These are backup files generated by rustfmt
**/*.rs.bk
